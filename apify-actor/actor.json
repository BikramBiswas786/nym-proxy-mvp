{
  "actorSpecVersion": 1,
  "name": "cloud-proxy-actor",
  "title": "Cloud Proxy Actor - Fast & Secure HTTP Proxy",
  "description": "Fast and secure cloud-based HTTP proxy actor for fetching and serving web content privately",
  "version": "3.0.0",
  "meta": {
    "author": "BikramBiswas786",
    "source": "https://github.com/BikramBiswas786/nym-proxy-mvp"
  },
  "input": {
    "title": "Proxy Configuration",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
      "url": {
        "title": "Target URL",
        "type": "string",
        "description": "The website URL to fetch",
        "editor": "textfield",
        "isRequired": true
      },
      "method": {
        "title": "HTTP Method",
        "type": "string",
        "description": "HTTP method (GET, POST, PUT, DELETE, etc.)",
        "editor": "select",
        "default": "GET",
        "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS"]
      },
      "headers": {
        "title": "Custom Headers",
        "type": "object",
        "description": "Custom HTTP headers as key-value pairs",
        "editor": "json",
        "default": {}
      },
      "body": {
        "title": "Request Body",
        "type": "string",
        "description": "Request body for POST/PUT requests",
        "editor": "textarea"
      },
      "timeoutMs": {
        "title": "Request Timeout (ms)",
        "type": "integer",
        "description": "Maximum time to wait for response (milliseconds)",
        "default": 120000,
        "minimum": 5000,
        "maximum": 300000
            },
    "proxyCountries": {
      "title": "Proxy Countries",
      "type": "array",
      "description": "Countries to use for proxy (ICELAND, DENMARK, etc.)",
      "editor": "select",
      "default": ["ICELAND", "DENMARK"],
      "enum": ["ICELAND", "DENMARK"],
      "isRequired": false
    
      }
    },
    "required": ["url"]
  },
  "dockerfile": "Dockerfile",
  "categories": [
    "SCRAPERS",
    "SECURITY",
    "PRIVACY"
  ],
  "resources": {
    "memoryMbytes": 512,
    "cpuCores": 0.5
  }
}
