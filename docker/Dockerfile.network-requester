FROM ubuntu:22.04

ENV NYM_VERSION=v2024.12-chomp
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    wget \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /nym

# Download Nym Network Requester
RUN wget https://github.com/nymtech/nym/releases/download/${NYM_VERSION}/nym-network-requester || \
    wget https://github.com/nymtech/nym/releases/latest/download/nym-network-requester && \
    chmod +x nym-network-requester

# Copy entrypoint and whitelist
COPY nr-entrypoint.sh /usr/local/bin/
COPY allowed-list.txt /nym/
RUN chmod +x /usr/local/bin/nr-entrypoint.sh

ENTRYPOINT ["nr-entrypoint.sh"]
CMD ["./nym-network-requester", "run", "--id", "custom-nr", "--enable-statistics"]