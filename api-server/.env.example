# Apify Configuration
APIFY_TOKEN=your_apify_token_here
ACTOR_ID=your_actor_id_here

# Server Configuration
PORT=8787
NODE_ENV=production

# Redis Configuration (Upstash)
# Get these from https://upstash.com/console
UPSTASH_REDIS_REST_URL=https://your-redis-cluster.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# API Keys for /v1/proxy
VALID_API_KEYS=test_key_123
